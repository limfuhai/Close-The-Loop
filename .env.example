# Close the Loop: local settings.
# Copy this file to .env and fill it in. Never commit .env.

# Secret shared by the server and your bridge. Any long random string, e.g. from:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=

# The email account your agents use (an app password or 授权码, not your normal password)
MAIL_ADDRESS=
MAIL_AUTH_CODE=

# Only for a custom mail server:
# MAIL_IMAP_HOST=
# MAIL_IMAP_PORT=993
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=465

# Port for the local backend
HTTP_PORT=8770

# Serve generated files from this machine instead of cloud storage
FORCE_LOCAL_OUTPUTS=true
